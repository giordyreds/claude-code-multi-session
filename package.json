{
  "name": "claude-code-multi-session",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "ccp": "dist/bin.js"
  },
  "files": [
    "dist",
    "shell"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/require-supported-node.mjs && tsc -p tsconfig.json --noEmit false && chmod +x dist/bin.js",
    "build:binaries": "scripts/build-binaries.sh",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.9.3",
    "vitest": "^2.0.5"
  }
}
